digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!p | !q) & F(p & (0R[x<=5]!q))"]
  1 -> 1 [label="!p | !q\n"]
  1 -> 2 [label="p & !q & reset(x0)\n{Acc[p & (0R[x<=5]!q)]}"]
  2 [label="(G(!p | !q) & (0R[x<=5-x0]!q)) | (G(!p | !q) & !\"x0<=5\")"]

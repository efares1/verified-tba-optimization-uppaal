digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(0R[x<=5]!p) | (1U[x<2]p)"]
  1 -> 2 [label="p\n"]
  1 -> 3 [label="!p & reset(x0)\n"]
  1 -> 4 [label="!p & reset(x1)\n"]
  2 [label="1"]
  2 -> 2 [label="1\n"]
  3 [label="(0R[x<=5-x0]!p) | !\"x0<=5\""]
  3 -> 2 [label="!\"x0<=5\"\n"]
  3 -> 3 [label="!p & \"x0<=5\"\n"]
  4 [label="(1U[x<2-x1]p) & \"x1<2\""]
  4 -> 2 [label="p & \"x1<2\"\n"]
  4 -> 4 [label="!p & \"x1<2\"\n"]
}

  1 -> 1 [label="!q | !p\n"]
  1 -> 2 [label="p & !q & reset(x0)\n{Acc[p & ((0R[x<=5]!q) | (1U[x<2]q))]}"]
  1 -> 3 [label="p & !q & reset(x1)\n{Acc[p & ((0R[x<=5]!q) | (1U[x<2]q))]}"]
  2 [label="(G(!q | !p) & (0R[x<=5-x0]!q)) | (G(!q | !p) & !\"x0<=5\")"]
  2 -> 4 [label="(!q & !\"x0<=5\") | (!p & !\"x0<=5\")\n{Acc[p & ((0R[x<=5]!q) | (1U[x<2]q))]}"]
  2 -> 2 [label="!q\n{Acc[p & ((0R[x<=5]!q) | (1U[x<2]q))]}"]
  3 [label="G(!q | !p) & (1U[x<2-x1]q) & \"x1<2\""]

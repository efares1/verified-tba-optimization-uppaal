digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="F(0R[x>=2]!p)"]
  1 -> 2 [label="reset(x0)\n{Acc[0R[x>=2]!p]}"]
  1 -> 3 [label="1\n{Acc[0R[x>=2]!p]}"]
  1 -> 1 [label="1\n"]
  2 [label="(0R[x>=2-x0]!p) & !\"x0>=2\""]
  2 -> 4 [label="!\"x0>=2\"\n{Acc[0R[x>=2]!p]}"]
  3 [label="G!p"]
  3 -> 3 [label="!p\n{Acc[0R[x>=2]!p]}"]
  4 [label="((0R[x>=2-x0]!p) & !\"x0>=2\") | G!p"]

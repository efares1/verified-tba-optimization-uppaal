digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(0R[x<=5](!pR[x<=2]!q)) & G(!q | !p)"]
  1 -> 2 [label="!q & reset(x0) & reset(x1)\n"]
  1 -> 3 [label="!q & !p & reset(x1)\n"]
  2 [label="(G(!q | !p) & (0R[x<=5-x1](!pR[x<=2]!q))) | (G(!q | !p) & (!pR[x<=2-x0]!q) & !\"x1<=5\") | (G(!q | !p) & !\"x0<=2\" & (0R[x<=5-x1](!pR[x<=2]!q))) | (G(!q | !p) & !\"x0<=2\" & !\"x1<=5\")"]
  2 -> 2 [label="!q & reset(x0)\n"]
  2 -> 4 [label="(!q & !p & !\"x1<=5\") | (!p & !\"x0<=2\" & !\"x1<=5\") | (!q & !\"x0<=2\" & !\"x1<=5\")\n"]
  2 -> 5 [label="!q & !\"x1<=5\"\n"]
  2 -> 3 [label="!q & !p\n"]
  3 [label="(G(!q | !p) & (0R[x<=5-x1](!pR[x<=2]!q))) | (G(!q | !p) & !\"x1<=5\")"]
  3 -> 2 [label="!q & reset(x0)\n"]
  3 -> 4 [label="(!p & !\"x1<=5\") | (!q & !\"x1<=5\")\n"]
  3 -> 3 [label="!q & !p\n"]
  4 [label="G(!q | !p)"]
  4 -> 4 [label="!q | !p\n"]
  5 [label="(G(!q | !p) & (!pR[x<=2-x0]!q)) | (G(!q | !p) & !\"x0<=2\")"]
  5 -> 4 [label="(!q & !p) | (!p & !\"x0<=2\") | (!q & !\"x0<=2\")\n"]
  5 -> 5 [label="!q\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!q & ((1U[x>=1]!p)R[x<2]p) & G(!p | !q)"]
  1 -> 2 [label="p & !q & reset(x0)\n"]
  1 -> 3 [label="p & !q & reset(x1)\n{Acc[!p]}"]
  2 [label="(G(!p | !q) & (1U[x>=1-x0]!p)) | (G(!p | !q) & \"x0>=1\" & F!p)"]
  2 -> 2 [label="!p\n{Acc[!p]}"]
  2 -> 2 [label="!q\n"]
  2 -> 4 [label="!p & \"x0>=1\"\n{Acc[!p]}"]
  2 -> 5 [label="!q & \"x0>=1\"\n"]
  3 [label="(G(!p | !q) & ((1U[x>=1]!p)R[x<2-x1]p)) | (G(!p | !q) & !\"x1<2\")"]
  3 -> 2 [label="p & !q & reset(x0)\n"]
  3 -> 3 [label="p & !q\n{Acc[!p]}"]
  3 -> 4 [label="(!q & !\"x1<2\") | (!p & !\"x1<2\")\n{Acc[!p]}"]
  4 [label="G(!p | !q)"]
  4 -> 4 [label="!p | !q\n{Acc[!p]}"]
  5 [label="G(!p | !q) & F!p"]
  5 -> 5 [label="!q\n"]
  5 -> 4 [label="!p\n{Acc[!p]}"]
}

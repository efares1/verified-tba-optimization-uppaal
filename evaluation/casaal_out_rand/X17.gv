digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!q | !r) & (1U[x>1](!r | (r & q)))"]
  1 -> 2 [label="!r & reset(x0)\n{Acc[!r | (r & q)]}"]
  1 -> 2 [label="!q & reset(x0)\n"]
  2 [label="(G(!q | !r) & (1U[x>1-x0](!r | (r & q)))) | (G(!q | !r) & \"x0>1\" & F(!r | (r & q)))"]
  2 -> 3 [label="!q & \"x0>1\"\n"]
  2 -> 4 [label="!r & \"x0>1\"\n{Acc[!r | (r & q)]}"]
  2 -> 2 [label="!r\n{Acc[!r | (r & q)]}"]
  2 -> 2 [label="!q\n"]
  3 [label="G(!q | !r) & F(!r | (r & q))"]
  3 -> 3 [label="!q\n"]
  3 -> 4 [label="!r\n{Acc[!r | (r & q)]}"]
  4 [label="G(!q | !r)"]
  4 -> 4 [label="!q | !r\n{Acc[!r | (r & q)]}"]
}

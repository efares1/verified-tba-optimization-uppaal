digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!r | !p) & (r | (0R[x<3]!p) | (1U[x<=1]!p))"]
  1 -> 2 [label="!p\n"]
  1 -> 3 [label="!r & reset(x1)\n"]
  2 [label="G(!r | !p)"]
  2 -> 2 [label="!r | !p\n"]
  3 [label="G(!r | !p) & (1U[x<=1-x1]!p) & \"x1<=1\""]
  3 -> 2 [label="!p & \"x1<=1\"\n"]
  3 -> 3 [label="!r & \"x1<=1\"\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!r & (0R[x<=1]p) & G(!r | !p) & (1U[x<3]p)"]
  1 -> 2 [label="!r & p & reset(x0)\n"]
  2 [label="(G(!r | !p) & (0R[x<=1-x0]p)) | (G(!r | !p) & !\"x0<=1\")"]
  2 -> 2 [label="!r & p\n"]
  2 -> 3 [label="(!r & !\"x0<=1\") | (!p & !\"x0<=1\")\n"]
  3 [label="G(!r | !p)"]
  3 -> 3 [label="!r | !p\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(!q | (1U[x<=1](p | r))) & G((!p | !q) & (!p | !r) & (!r | !q))"]
  1 -> 2 [label="(!p & !q) | (!r & !q)\n"]
  1 -> 3 [label="!p & !r & reset(x0)\n"]
  2 [label="G((!p | !q) & (!p | !r) & (!r | !q))"]
  2 -> 2 [label="(!p & !q) | (!r & !q) | (!p & !r)\n"]
  3 [label="G((!p | !q) & (!p | !r) & (!r | !q)) & (1U[x<=1-x0](p | r)) & \"x0<=1\""]
  3 -> 2 [label="(!p & r & !q & \"x0<=1\") | (p & !r & !q & \"x0<=1\")\n"]
  3 -> 3 [label="!p & !r & \"x0<=1\"\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="0R[x>1](1U[x<=2]!r)"]
  1 -> 2 [label="reset(x1)\n"]
  1 -> 3 [label="1\n"]
  2 [label="(0R[x>1-x1](1U[x<=2]!r)) & !\"x1>1\""]
  2 -> 4 [label="!\"x1>1\"\n"]
  3 [label="G(1U[x<=2]!r)"]
  3 -> 5 [label="reset(x0)\n"]
  3 -> 3 [label="!r\n"]
  4 [label="((0R[x>1-x1](1U[x<=2]!r)) & !\"x1>1\") | G(1U[x<=2]!r)"]
  4 -> 5 [label="reset(x0)\n"]
  4 -> 3 [label="!r\n"]
  4 -> 4 [label="!\"x1>1\"\n"]
  5 [label="(1U[x<=2-x0]!r) & \"x0<=2\" & G(1U[x<=2]!r)"]
  5 -> 5 [label="\"x0<=2\"\n"]
  5 -> 3 [label="!r & \"x0<=2\"\n"]
}

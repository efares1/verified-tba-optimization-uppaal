digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(r | (pU[x>1]!r) | (rU[x<=2]q)) & G((!p | !q) & (!r | !p) & (!r | !q))"]
  1 -> 2 [label="(!r & q & !p) | (r & !p & !q)\n"]
  1 -> 3 [label="p & !r & !q & reset(x0)\n"]
  2 [label="G((!p | !q) & (!r | !p) & (!r | !q))"]
  2 -> 2 [label="(!r & !p) | (!r & !q) | (!p & !q)\n"]
  3 [label="(G((!p | !q) & (!r | !p) & (!r | !q)) & (pU[x>1-x0]!r)) | (G((!p | !q) & (!r | !p) & (!r | !q)) & \"x0>1\" & (p U !r))"]
  3 -> 2 [label="(!r & !p & \"x0>1\") | (!r & !q & \"x0>1\")\n"]
  3 -> 3 [label="p & !r & !q\n"]
}

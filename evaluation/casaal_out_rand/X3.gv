digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(0R[x<3](1U[x<=1](p & !r))) & G(!r | !p)"]
  1 -> 2 [label="!p & reset(x0) & reset(x1)\n"]
  1 -> 3 [label="p & !r & reset(x1)\n"]
  2 [label="(G(!r | !p) & (1U[x<=1-x0](p & !r)) & \"x0<=1\" & (0R[x<3-x1](1U[x<=1](p & !r)))) | (G(!r | !p) & (1U[x<=1-x0](p & !r)) & \"x0<=1\" & !\"x1<3\")"]
  2 -> 4 [label="!p & \"x0<=1\" & !\"x1<3\"\n"]
  2 -> 5 [label="p & !r & \"x0<=1\" & !\"x1<3\"\n"]
  2 -> 2 [label="!p & \"x0<=1\"\n"]
  2 -> 3 [label="p & !r & \"x0<=1\"\n"]
  3 [label="(G(!r | !p) & (0R[x<3-x1](1U[x<=1](p & !r)))) | (G(!r | !p) & !\"x1<3\")"]
  3 -> 5 [label="(!p & !\"x1<3\") | (!r & !\"x1<3\")\n"]
  3 -> 2 [label="!p & reset(x0)\n"]
  3 -> 3 [label="p & !r\n"]
  4 [label="G(!r | !p) & (1U[x<=1-x0](p & !r)) & \"x0<=1\""]
  4 -> 4 [label="!p & \"x0<=1\"\n"]
  4 -> 5 [label="p & !r & \"x0<=1\"\n"]
  5 [label="G(!r | !p)"]
  5 -> 5 [label="!r | !p\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(0R[x>1](p & q)) & G(!p | !q)"]
  1 -> 2 [label="(!p & reset(x0)) | (!q & reset(x0))\n"]
  1 -> 3 [label="!p | !q\n"]
  2 [label="G(!p | !q) & (0R[x>1-x0](p & q)) & !\"x0>1\""]
  2 -> 4 [label="(!p & !\"x0>1\") | (!q & !\"x0>1\")\n"]
  3 [label="G(p & q & (!p | !q))"]
  4 [label="(G(!p | !q) & (0R[x>1-x0](p & q)) & !\"x0>1\") | G(p & q & (!p | !q))"]
  4 -> 4 [label="(!p & !\"x0>1\") | (!q & !\"x0>1\")\n"]
}

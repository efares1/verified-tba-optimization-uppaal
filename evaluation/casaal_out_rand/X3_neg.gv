digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<3](0R[x<=1](r | !p))) & G(!r | !p)"]
  1 -> 2 [label="(!r & reset(x1)) | (!p & reset(x1))\n"]
  1 -> 3 [label="!p & reset(x0)\n"]
  2 [label="G(!r | !p) & (1U[x<3-x1](0R[x<=1](r | !p))) & \"x1<3\""]
  2 -> 2 [label="(!r & \"x1<3\") | (!p & \"x1<3\")\n"]
  2 -> 3 [label="!p & reset(x0) & \"x1<3\"\n"]
  3 [label="(G(!r | !p) & (0R[x<=1-x0](r | !p))) | (G(!r | !p) & !\"x0<=1\")"]
  3 -> 4 [label="(!r & !\"x0<=1\") | (!p & !\"x0<=1\")\n"]
  3 -> 3 [label="!p\n"]
  4 [label="G(!r | !p)"]
  4 -> 4 [label="!r | !p\n"]
}

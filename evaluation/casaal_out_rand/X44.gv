digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="((0R[x<3](0R[x<2]p)) | (p & !p & (0R[x<=3]r))) & G(!p | !r)"]
  1 -> 2 [label="p & !r & reset(x0) & reset(x1)\n"]
  2 [label="(G(!p | !r) & (0R[x<2-x0]p) & (0R[x<3-x1](0R[x<2]p))) | (G(!p | !r) & (0R[x<2-x0]p) & !\"x1<3\") | (G(!p | !r) & !\"x0<2\" & (0R[x<3-x1](0R[x<2]p))) | (G(!p | !r) & !\"x0<2\" & !\"x1<3\")"]
  2 -> 3 [label="p & !r & !\"x1<3\"\n"]

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<3](1U[x<2]!p)) & (p | !p | (1U[x<=3]!r)) & G(!p | !r)"]
  1 -> 2 [label="!p\n"]
  1 -> 3 [label="!r & reset(x0)\n"]
  1 -> 4 [label="!r & reset(x1)\n"]
  2 [label="G(!p | !r)"]
  2 -> 2 [label="!p | !r\n"]
  3 [label="G(!p | !r) & (1U[x<2-x0]!p) & \"x0<2\""]
  3 -> 2 [label="!p & \"x0<2\"\n"]
  3 -> 3 [label="!r & \"x0<2\"\n"]
  4 [label="G(!p | !r) & (1U[x<3-x1](1U[x<2]!p)) & \"x1<3\""]
  4 -> 2 [label="!p & \"x1<3\"\n"]
  4 -> 3 [label="!r & reset(x0) & \"x1<3\"\n"]
  4 -> 4 [label="!r & \"x1<3\"\n"]
}

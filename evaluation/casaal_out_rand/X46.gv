digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!p | !r) & (1U[x<2]((pU[x<=1]r) | (0R[x>1]!p)))"]
  1 -> 2 [label="!r\n"]
  1 -> 3 [label="!r & reset(x2)\n"]
  1 -> 4 [label="p & !r & reset(x0)\n"]
  1 -> 5 [label="!r & reset(x1)\n"]
  1 -> 6 [label="r & !p\n"]
  2 [label="G(!p & (!p | !r))"]
  2 -> 2 [label="!p\n"]
  3 [label="G(!p | !r) & (1U[x<2-x2]((pU[x<=1]r) | (0R[x>1]!p))) & \"x2<2\""]
  3 -> 4 [label="p & !r & reset(x0) & \"x2<2\"\n"]
  3 -> 5 [label="!r & reset(x1) & \"x2<2\"\n"]
  3 -> 6 [label="r & !p & \"x2<2\"\n"]
  3 -> 7 [label="!r & \"x2<2\"\n"]
  4 [label="G(!p | !r) & (pU[x<=1-x0]r) & \"x0<=1\""]
  4 -> 4 [label="p & !r & \"x0<=1\"\n"]
  4 -> 6 [label="r & !p & \"x0<=1\"\n"]
  5 [label="G(!p | !r) & (0R[x>1-x1]!p) & !\"x1>1\""]
  5 -> 8 [label="(!p & !\"x1>1\") | (!r & !\"x1>1\")\n"]
  6 [label="G(!p | !r)"]
  6 -> 6 [label="!p | !r\n"]
  7 [label="G(!p & (!p | !r)) | (G(!p | !r) & (1U[x<2-x2]((pU[x<=1]r) | (0R[x>1]!p))) & \"x2<2\")"]
  7 -> 2 [label="!p\n"]
  7 -> 4 [label="p & !r & reset(x0) & \"x2<2\"\n"]
  7 -> 5 [label="!r & reset(x1) & \"x2<2\"\n"]
  7 -> 6 [label="r & !p & \"x2<2\"\n"]
  7 -> 7 [label="!r & \"x2<2\"\n"]
  8 [label="(G(!p | !r) & (0R[x>1-x1]!p) & !\"x1>1\") | G(!p & (!p | !r))"]
  8 -> 8 [label="(!p & !\"x1>1\") | (!r & !\"x1>1\")\n"]
  8 -> 2 [label="!p\n"]
}

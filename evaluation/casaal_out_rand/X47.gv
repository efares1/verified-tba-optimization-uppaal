digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(p | (0R[x<3]!q)) & G(!p | !q)"]
  1 -> 2 [label="!q & reset(x0)\n"]
  1 -> 3 [label="p & !q\n"]
  2 [label="(G(!p | !q) & (0R[x<3-x0]!q)) | (G(!p | !q) & !\"x0<3\")"]
  2 -> 2 [label="!q\n"]
  2 -> 3 [label="(!p & !\"x0<3\") | (!q & !\"x0<3\")\n"]
  3 [label="G(!p | !q)"]
  3 -> 3 [label="!p | !q\n"]
}

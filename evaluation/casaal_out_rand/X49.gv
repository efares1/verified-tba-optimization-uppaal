  7 -> 3 [label="!r & reset(x1) & \"x2<=2\"\n"]
  7 -> 5 [label="!p & \"x2<=2\"\n"]
  7 -> 6 [label="!r & reset(x0) & \"x2<=2\"\n"]
  8 [label="(G(!r | !p) & (0R[x>2-x0]!r) & !\"x0>2\") | G(!r & (!r | !p))"]

  3 -> 5 [label="!p & \"x1<2\"\n"]
  4 [label="G(!r | !p) & (1U[x<=2-x2]((0R[x>2]!r) | (1U[x<2]!p))) & \"x2<=2\""]
  4 -> 7 [label="!r & \"x2<=2\"\n"]
  4 -> 3 [label="!r & reset(x1) & \"x2<=2\"\n"]
  4 -> 5 [label="!p & \"x2<=2\"\n"]
  4 -> 6 [label="!r & reset(x0) & \"x2<=2\"\n"]

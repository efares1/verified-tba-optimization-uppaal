digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!r & G(!q | !r) & ((q | r) U (1U[x<=2]q))"]
  1 -> 2 [label="!r & reset(x0)\n"]
  1 -> 3 [label="q & !r\n"]
  2 [label="G(!q | !r) & (1U[x<=2-x0]q) & \"x0<=2\""]
  2 -> 2 [label="!q & \"x0<=2\"\n"]
  2 -> 3 [label="q & !r & \"x0<=2\"\n"]
  3 [label="G(!q | !r)"]
  3 -> 3 [label="!q | !r\n"]
}

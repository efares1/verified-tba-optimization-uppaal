digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(Fp | ((q & !q)U[x<2](!pU[x>=1]!p))) & G(!q | !p)"]
  1 -> 2 [label="p & !q\n{Acc[p]}"]
  1 -> 3 [label="!p\n"]
  1 -> 4 [label="!p & reset(x0)\n{Acc[p]}"]
  2 [label="G(!q | !p)"]
  2 -> 2 [label="!q | !p\n{Acc[p]}"]
  3 [label="Fp & G(!q | !p)"]
  3 -> 2 [label="p & !q\n{Acc[p]}"]
  3 -> 3 [label="!p\n"]
  4 [label="(G(!q | !p) & (!pU[x>=1-x0]!p)) | (G(!q | !p) & \"x0>=1\" & (!p U !p))"]
  4 -> 2 [label="!p & \"x0>=1\"\n{Acc[p]}"]
  4 -> 4 [label="!p\n{Acc[p]}"]
}

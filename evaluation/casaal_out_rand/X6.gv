digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<3](!p | (1U[x>1]r))) & G(!p | !r)"]
  1 -> 2 [label="!p\n{Acc[r]}"]
  1 -> 3 [label="!r & reset(x0)\n"]
  1 -> 4 [label="!r & reset(x1)\n{Acc[r]}"]
  2 [label="G(!p | !r)"]
  2 -> 2 [label="!p | !r\n{Acc[r]}"]
  3 [label="(G(!p | !r) & (1U[x>1-x0]r)) | (G(!p | !r) & \"x0>1\" & Fr)"]
  3 -> 5 [label="!r & \"x0>1\"\n"]
  3 -> 2 [label="!p & r & \"x0>1\"\n{Acc[r]}"]
  3 -> 3 [label="!p & r\n{Acc[r]}"]
  3 -> 3 [label="!r\n"]
  4 [label="G(!p | !r) & (1U[x<3-x1](!p | (1U[x>1]r))) & \"x1<3\""]
  4 -> 2 [label="!p & \"x1<3\"\n{Acc[r]}"]
  4 -> 3 [label="!r & reset(x0) & \"x1<3\"\n"]
  4 -> 4 [label="!r & \"x1<3\"\n{Acc[r]}"]
  5 [label="G(!p | !r) & Fr"]
  5 -> 5 [label="!r\n"]
  5 -> 2 [label="!p & r\n{Acc[r]}"]
}

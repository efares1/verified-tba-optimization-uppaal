digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(!r | ((0R[x<=1]!r)R[x<=3]!q)) & G(!r | !q)"]
  1 -> 2 [label="!r\n"]
  1 -> 3 [label="!q & reset(x1)\n"]
  2 [label="G(!r | !q)"]
  2 -> 2 [label="!r | !q\n"]
  3 [label="(G(!r | !q) & ((0R[x<=1]!r)R[x<=3-x1]!q)) | (G(!r | !q) & !\"x1<=3\")"]
  3 -> 4 [label="!r & !q & reset(x0)\n"]
  3 -> 2 [label="(!r & !\"x1<=3\") | (!q & !\"x1<=3\")\n"]
  3 -> 3 [label="!q\n"]
  4 [label="(G(!r | !q) & (0R[x<=1-x0]!r)) | (G(!r | !q) & !\"x0<=1\")"]
  4 -> 4 [label="!r\n"]
  4 -> 2 [label="(!r & !\"x0<=1\") | (!q & !\"x0<=1\")\n"]
}

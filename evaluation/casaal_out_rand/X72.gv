digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!q & G(!q | !p) & (0R[x>2]!p)"]
  1 -> 2 [label="!q\n"]
  1 -> 3 [label="!q & reset(x0)\n"]
  2 [label="G(!p & (!q | !p))"]
  2 -> 2 [label="!p\n"]
  3 [label="G(!q | !p) & (0R[x>2-x0]!p) & !\"x0>2\""]
  3 -> 4 [label="(!q & !\"x0>2\") | (!p & !\"x0>2\")\n"]
  4 [label="(G(!q | !p) & (0R[x>2-x0]!p) & !\"x0>2\") | G(!p & (!q | !p))"]
  4 -> 2 [label="!p\n"]
  4 -> 4 [label="(!q & !\"x0>2\") | (!p & !\"x0>2\")\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!q | !p) & (q | (1U[x>2]p))"]
  1 -> 2 [label="!q & p & reset(x0)\n{Acc[p]}"]
  1 -> 2 [label="!p & reset(x0)\n"]
  1 -> 3 [label="q & !p\n{Acc[p]}"]
  2 [label="(G(!q | !p) & (1U[x>2-x0]p)) | (G(!q | !p) & \"x0>2\" & Fp)"]
  2 -> 2 [label="!q & p\n{Acc[p]}"]
  2 -> 2 [label="!p\n"]
  2 -> 4 [label="!p & \"x0>2\"\n"]
  2 -> 3 [label="!q & p & \"x0>2\"\n{Acc[p]}"]
  3 [label="G(!q | !p)"]
  3 -> 3 [label="!q | !p\n{Acc[p]}"]
  4 [label="G(!q | !p) & Fp"]
  4 -> 4 [label="!p\n"]
  4 -> 3 [label="!q & p\n{Acc[p]}"]
}

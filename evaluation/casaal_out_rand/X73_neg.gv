digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="0R[x>=2](0R[x<=1]r)"]
  1 -> 2 [label="reset(x1)\n"]
  1 -> 3 [label="1\n"]
  2 [label="(0R[x>=2-x1](0R[x<=1]r)) & !\"x1>=2\""]
  2 -> 4 [label="!\"x1>=2\"\n"]
  3 [label="G(0R[x<=1]r)"]
  3 -> 5 [label="r & reset(x0)\n"]
  4 [label="((0R[x>=2-x1](0R[x<=1]r)) & !\"x1>=2\") | G(0R[x<=1]r)"]
  4 -> 5 [label="r & reset(x0)\n"]
  4 -> 4 [label="!\"x1>=2\"\n"]
  5 [label="G(0R[x<=1]r) | (!\"x0<=1\" & G(0R[x<=1]r))"]
  5 -> 5 [label="r & reset(x0)\n"]
}

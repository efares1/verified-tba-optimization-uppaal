digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<=1](1U[x<=3](!qU[x>2]r))) & G(!q | !r)"]
  1 -> 2 [label="(!q & reset(x1)) | (!r & reset(x1))\n{Acc[r]}"]
  1 -> 3 [label="(!q & reset(x2)) | (!r & reset(x2))\n{Acc[r]}"]
  1 -> 4 [label="!q & r & reset(x0)\n{Acc[r]}"]
  1 -> 4 [label="!q & reset(x0)\n"]
  2 [label="G(!q | !r) & (1U[x<=3-x1](!qU[x>2]r)) & \"x1<=3\""]
  2 -> 2 [label="(!q & \"x1<=3\") | (!r & \"x1<=3\")\n{Acc[r]}"]
  2 -> 4 [label="!q & r & reset(x0) & \"x1<=3\"\n{Acc[r]}"]
  2 -> 4 [label="!q & reset(x0) & \"x1<=3\"\n"]
  3 [label="G(!q | !r) & (1U[x<=1-x2](1U[x<=3](!qU[x>2]r))) & \"x2<=1\""]
  3 -> 2 [label="(!q & reset(x1) & \"x2<=1\") | (!r & reset(x1) & \"x2<=1\")\n{Acc[r]}"]
  3 -> 3 [label="(!q & \"x2<=1\") | (!r & \"x2<=1\")\n{Acc[r]}"]
  3 -> 4 [label="!q & r & reset(x0) & \"x2<=1\"\n{Acc[r]}"]
  3 -> 4 [label="!q & reset(x0) & \"x2<=1\"\n"]
  4 [label="(G(!q | !r) & (!qU[x>2-x0]r)) | (G(!q | !r) & \"x0>2\" & (!q U r))"]
  4 -> 5 [label="!q & r & \"x0>2\"\n{Acc[r]}"]
  4 -> 6 [label="!q & \"x0>2\"\n"]
  4 -> 4 [label="!q & r\n{Acc[r]}"]
  4 -> 4 [label="!q\n"]
  5 [label="G(!q | !r)"]
  5 -> 5 [label="!q | !r\n{Acc[r]}"]
  6 [label="G(!q | !r) & (!q U r)"]
  6 -> 5 [label="!q & r\n{Acc[r]}"]
  6 -> 6 [label="!q\n"]
}

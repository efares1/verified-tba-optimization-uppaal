digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(!q | (0R[x>=2]r) | (!rU[x>1]q)) & G(!q | !r)"]
  1 -> 2 [label="!r\n{Acc[q]}"]
  1 -> 3 [label="!r & reset(x1)\n{Acc[q]}"]
  1 -> 4 [label="!q\n{Acc[q]}"]
  1 -> 5 [label="!r & reset(x0)\n{Acc[q]}"]
  2 [label="G(r & (!q | !r))"]
  2 -> 2 [label="!q & r\n{Acc[q]}"]
  3 [label="(G(!q | !r) & (!rU[x>1-x1]q)) | (G(!q | !r) & \"x1>1\" & (!r U q))"]
  3 -> 3 [label="q & !r\n{Acc[q]}"]
  3 -> 3 [label="!r\n"]
  3 -> 4 [label="q & !r & \"x1>1\"\n{Acc[q]}"]
  3 -> 6 [label="!r & \"x1>1\"\n"]
  4 [label="G(!q | !r)"]
  4 -> 4 [label="!q | !r\n{Acc[q]}"]
  5 [label="G(!q | !r) & (0R[x>=2-x0]r) & !\"x0>=2\""]
  5 -> 7 [label="(!q & !\"x0>=2\") | (!r & !\"x0>=2\")\n{Acc[q]}"]
  6 [label="G(!q | !r) & (!r U q)"]
  6 -> 4 [label="q & !r\n{Acc[q]}"]
  6 -> 6 [label="!r\n"]
  7 [label="(G(!q | !r) & (0R[x>=2-x0]r) & !\"x0>=2\") | G(r & (!q | !r))"]
  7 -> 2 [label="!q & r\n{Acc[q]}"]
  7 -> 7 [label="(!q & !\"x0>=2\") | (!r & !\"x0>=2\")\n{Acc[q]}"]
}

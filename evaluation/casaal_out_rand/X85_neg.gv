digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!p & ((1U[x>2]!q) | (!rR[x<=2]p)) & G((!p | !q) & (!p | !r) & (!q | !r))"]
  1 -> 2 [label="!p & !q & reset(x0)\n{Acc[!q]}"]
  1 -> 2 [label="!p & !r & reset(x0)\n"]
  2 [label="(G((!p | !q) & (!p | !r) & (!q | !r)) & (1U[x>2-x0]!q)) | (G((!p | !q) & (!p | !r) & (!q | !r)) & \"x0>2\" & F!q)"]
  2 -> 3 [label="!p & !r & \"x0>2\"\n"]
  2 -> 4 [label="(!p & !q & \"x0>2\") | (!q & !r & \"x0>2\")\n{Acc[!q]}"]
  2 -> 2 [label="(!p & !q) | (!q & !r)\n{Acc[!q]}"]
  2 -> 2 [label="!p & !r\n"]
  3 [label="G((!p | !q) & (!p | !r) & (!q | !r)) & F!q"]
  3 -> 3 [label="!p & !r\n"]
  3 -> 4 [label="(!p & !q) | (!q & !r)\n{Acc[!q]}"]
  4 [label="G((!p | !q) & (!p | !r) & (!q | !r))"]
  4 -> 4 [label="(!p & !q) | (!p & !r) | (!q & !r)\n{Acc[!q]}"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="0R[x>=1](p & (0R[x<2]p))"]
  1 -> 2 [label="reset(x1)\n"]
  1 -> 3 [label="1\n"]
  2 [label="(0R[x>=1-x1](p & (0R[x<2]p))) & !\"x1>=1\""]
  2 -> 4 [label="!\"x1>=1\"\n"]
  3 [label="G(p & (0R[x<2]p))"]
  3 -> 5 [label="p & reset(x0)\n"]
  4 [label="((0R[x>=1-x1](p & (0R[x<2]p))) & !\"x1>=1\") | G(p & (0R[x<2]p))"]
  4 -> 4 [label="!\"x1>=1\"\n"]
  4 -> 5 [label="p & reset(x0)\n"]
  5 [label="G(p & (0R[x<2]p)) | (!\"x0<2\" & G(p & (0R[x<2]p)))"]
  5 -> 5 [label="p & reset(x0)\n"]
}

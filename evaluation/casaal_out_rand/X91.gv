digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!q & (0R[x<=1](1U[x<=1]!q)) & r & G(!q | !r)"]
  1 -> 2 [label="!q & r & reset(x1)\n"]
  2 [label="(G(!q | !r) & (0R[x<=1-x1](1U[x<=1]!q))) | (G(!q | !r) & !\"x1<=1\")"]
  2 -> 3 [label="(!q & !\"x1<=1\") | (!r & !\"x1<=1\")\n"]
  2 -> 2 [label="!q\n"]
  2 -> 4 [label="!r & reset(x0)\n"]
  3 [label="G(!q | !r)"]
  3 -> 3 [label="!q | !r\n"]
  4 [label="(G(!q | !r) & (1U[x<=1-x0]!q) & \"x0<=1\" & (0R[x<=1-x1](1U[x<=1]!q))) | (G(!q | !r) & (1U[x<=1-x0]!q) & \"x0<=1\" & !\"x1<=1\")"]
  4 -> 5 [label="!r & \"x0<=1\" & !\"x1<=1\"\n"]
  4 -> 3 [label="!q & \"x0<=1\" & !\"x1<=1\"\n"]
  4 -> 2 [label="!q & \"x0<=1\"\n"]
  4 -> 4 [label="!r & \"x0<=1\"\n"]
  5 [label="G(!q | !r) & (1U[x<=1-x0]!q) & \"x0<=1\""]
  5 -> 5 [label="!r & \"x0<=1\"\n"]
  5 -> 3 [label="!q & \"x0<=1\"\n"]
}

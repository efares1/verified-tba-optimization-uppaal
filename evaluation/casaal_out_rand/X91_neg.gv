digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(q | (1U[x<=1](0R[x<=1]q)) | !r) & G(!q | !r)"]
  1 -> 2 [label="!q & reset(x1)\n"]
  1 -> 3 [label="!r\n"]
  2 [label="G(!q | !r) & (1U[x<=1-x1](0R[x<=1]q)) & \"x1<=1\""]
  2 -> 4 [label="q & !r & reset(x0) & \"x1<=1\"\n"]
  2 -> 2 [label="(!q & \"x1<=1\") | (!r & \"x1<=1\")\n"]
  3 [label="G(!q | !r)"]
  3 -> 3 [label="!q | !r\n"]
  4 [label="(G(!q | !r) & (0R[x<=1-x0]q)) | (G(!q | !r) & !\"x0<=1\")"]
  4 -> 4 [label="q & !r\n"]
  4 -> 3 [label="(!q & !\"x0<=1\") | (!r & !\"x0<=1\")\n"]
}

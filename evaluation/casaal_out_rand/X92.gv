digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<=2](Fp | !r)) & G(!r | !p)"]
  1 -> 2 [label="!p & reset(x0)\n{Acc[p]}"]
  1 -> 3 [label="!r\n{Acc[p]}"]
  1 -> 4 [label="!p\n"]
  2 [label="G(!r | !p) & (1U[x<=2-x0](Fp | !r)) & \"x0<=2\""]
  2 -> 2 [label="!p & \"x0<=2\"\n{Acc[p]}"]
  2 -> 3 [label="!r & \"x0<=2\"\n{Acc[p]}"]
  2 -> 4 [label="!p & \"x0<=2\"\n"]
  3 [label="G(!r | !p)"]
  3 -> 3 [label="!r | !p\n{Acc[p]}"]
  4 [label="Fp & G(!r | !p)"]
  4 -> 3 [label="p & !r\n{Acc[p]}"]
  4 -> 4 [label="!p\n"]
}

digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(0R[x<=2](r & G!p)) & G(!r | !p)"]
  1 -> 2 [label="r & !p & reset(x0)\n"]
  2 [label="((0R[x<=2-x0](r & G!p)) & G(!p & (!r | !p))) | (!\"x0<=2\" & G(!p & (!r | !p)))"]
  2 -> 3 [label="!p & !\"x0<=2\"\n"]
  2 -> 2 [label="r & !p\n"]
  3 [label="G(!p & (!r | !p))"]
  3 -> 3 [label="!p\n"]
}

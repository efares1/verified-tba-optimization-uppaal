digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="0R[x>2](q | (0R[x<=1]!q))"]
  1 -> 2 [label="reset(x1)\n"]
  1 -> 3 [label="1\n"]
  2 [label="(0R[x>2-x1](q | (0R[x<=1]!q))) & !\"x1>2\""]
  2 -> 4 [label="!\"x1>2\"\n"]
  3 [label="G(q | (0R[x<=1]!q))"]
  3 -> 3 [label="q\n"]
  3 -> 5 [label="reset(x0)\n"]
  4 [label="((0R[x>2-x1](q | (0R[x<=1]!q))) & !\"x1>2\") | G(q | (0R[x<=1]!q))"]
  4 -> 3 [label="q\n"]
  4 -> 4 [label="!\"x1>2\"\n"]
  4 -> 5 [label="reset(x0)\n"]
  5 [label="((0R[x<=1-x0]!q) & G(q | (0R[x<=1]!q))) | (!\"x0<=1\" & G(q | (0R[x<=1]!q)))"]

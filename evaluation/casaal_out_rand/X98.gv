digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="!p & (0R[x<2]q) & G(!p | !q)"]
  1 -> 2 [label="!p & q & reset(x0)\n"]
  2 [label="(G(!p | !q) & (0R[x<2-x0]q)) | (G(!p | !q) & !\"x0<2\")"]
  2 -> 2 [label="!p & q\n"]
  2 -> 3 [label="(!p & !\"x0<2\") | (!q & !\"x0<2\")\n"]
  3 [label="G(!p | !q)"]
  3 -> 3 [label="!p | !q\n"]
}

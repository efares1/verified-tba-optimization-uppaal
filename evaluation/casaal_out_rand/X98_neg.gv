digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(p | (1U[x<2]!q)) & G(!p | !q)"]
  1 -> 2 [label="!p & reset(x0)\n"]
  1 -> 3 [label="!q\n"]
  2 [label="G(!p | !q) & (1U[x<2-x0]!q) & \"x0<2\""]
  2 -> 2 [label="!p & \"x0<2\"\n"]
  2 -> 3 [label="!q & \"x0<2\"\n"]
  3 [label="G(!p | !q)"]
  3 -> 3 [label="!p | !q\n"]
}

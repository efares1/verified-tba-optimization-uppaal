digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(((1U[x<=5]q) | !p) & (!p | !q))"]
  1 -> 2 [label="!q & reset(x0)\n"]
  1 -> 1 [label="!p\n"]
  2 [label="G(((1U[x<=5]q) | !p) & (!p | !q)) & (1U[x<=5-x0]q) & \"x0<=5\""]
  2 -> 2 [label="!q & \"x0<=5\"\n"]
  2 -> 1 [label="q & !p & \"x0<=5\"\n"]
}

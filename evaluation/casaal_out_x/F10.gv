digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<=5]((0R[x<=3](p | q))U[x<=2]q)) & G(!p | !q)"]
  1 -> 2 [label="!q & reset(x2)\n"]
  1 -> 3 [label="q & !p\n"]
  1 -> 4 [label="p & !q & reset(x0) & reset(x1)\n"]
  2 [label="G(!p | !q) & (1U[x<=5-x2]((0R[x<=3](p | q))U[x<=2]q)) & \"x2<=5\""]
  2 -> 2 [label="!q & \"x2<=5\"\n"]
  2 -> 3 [label="q & !p & \"x2<=5\"\n"]
  2 -> 4 [label="p & !q & reset(x0) & reset(x1) & \"x2<=5\"\n"]
  3 [label="G(!p | !q)"]
  3 -> 3 [label="!p | !q\n"]
  4 [label="(G(!p | !q) & (0R[x<=3-x0](p | q)) & ((0R[x<=3](p | q))U[x<=2-x1]q) & \"x1<=2\") | (G(!p | !q) & !\"x0<=3\" & ((0R[x<=3](p | q))U[x<=2-x1]q) & \"x1<=2\")"]
  4 -> 3 [label="q & !p & !\"x0<=3\" & \"x1<=2\"\n"]
  4 -> 5 [label="q & !p & \"x1<=2\"\n"]
  4 -> 4 [label="p & !q & reset(x0) & \"x1<=2\"\n"]
  5 [label="(G(!p | !q) & (0R[x<=3-x0](p | q))) | (G(!p | !q) & !\"x0<=3\")"]
  5 -> 3 [label="(!p & !\"x0<=3\") | (!q & !\"x0<=3\")\n"]
  5 -> 5 [label="(q & !p) | (p & !q)\n"]
}

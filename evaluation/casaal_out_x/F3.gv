digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(!e | X(0R[x<=2]!e))"]
  1 -> 2 [label="1\n"]
  1 -> 1 [label="!e\n"]
  2 [label="(0R[x<=2]!e) & G(!e | X(0R[x<=2]!e))"]
  2 -> 3 [label="!e & reset(x0)\n"]
  3 [label="(G(!e | X(0R[x<=2]!e)) & (0R[x<=2-x0]!e)) | (G(!e | X(0R[x<=2]!e)) & !\"x0<=2\")"]
  3 -> 2 [label="!\"x0<=2\"\n"]
  3 -> 3 [label="!e\n"]
  3 -> 1 [label="!e & !\"x0<=2\"\n"]
}

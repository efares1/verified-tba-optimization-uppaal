digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<=5](pU[x<=2]q)) & G(!p | !q)"]
  1 -> 2 [label="p & !q & reset(x0)\n"]
  1 -> 3 [label="q & !p\n"]
  1 -> 4 [label="!q & reset(x1)\n"]
  2 [label="G(!p | !q) & (pU[x<=2-x0]q) & \"x0<=2\""]
  2 -> 2 [label="p & !q & \"x0<=2\"\n"]
  2 -> 3 [label="q & !p & \"x0<=2\"\n"]
  3 [label="G(!p | !q)"]
  3 -> 3 [label="!p | !q\n"]
  4 [label="G(!p | !q) & (1U[x<=5-x1](pU[x<=2]q)) & \"x1<=5\""]
  4 -> 2 [label="p & !q & reset(x0) & \"x1<=5\"\n"]
  4 -> 3 [label="q & !p & \"x1<=5\"\n"]
  4 -> 4 [label="!q & \"x1<=5\"\n"]
}

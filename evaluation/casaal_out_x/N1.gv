digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="1U[x<=5]p1"]
  1 -> 2 [label="p1\n"]
  1 -> 3 [label="reset(x0) & !p1\n"]
  2 [label="1"]
  2 -> 2 [label="1\n"]
  3 [label="(1U[x<=5-x0]p1) & \"x0<=5\""]
  3 -> 2 [label="p1 & \"x0<=5\"\n"]
  3 -> 3 [label="\"x0<=5\" & !p1\n"]
}

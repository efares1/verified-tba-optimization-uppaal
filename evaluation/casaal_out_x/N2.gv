digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="(1U[x<=5](p1 & (1U[x<=5]p2))) & G(!p1 | !p2)"]
  1 -> 2 [label="(!p1 & reset(x1)) | (!p2 & reset(x1))\n"]
  1 -> 3 [label="p1 & !p2 & reset(x0)\n"]
  2 [label="G(!p1 | !p2) & (1U[x<=5-x1](p1 & (1U[x<=5]p2))) & \"x1<=5\""]
  2 -> 2 [label="(!p1 & \"x1<=5\") | (!p2 & \"x1<=5\")\n"]
  2 -> 3 [label="p1 & !p2 & reset(x0) & \"x1<=5\"\n"]
  3 [label="G(!p1 | !p2) & (1U[x<=5-x0]p2) & \"x0<=5\""]
  3 -> 4 [label="p2 & !p1 & \"x0<=5\"\n"]
  3 -> 3 [label="!p2 & \"x0<=5\"\n"]
  4 [label="G(!p1 | !p2)"]
  4 -> 4 [label="!p1 | !p2\n"]
}

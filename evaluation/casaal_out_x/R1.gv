digraph G {
  0 [label="", style=invis, height=0]
  0 -> 1
  1 [label="G(((1U[x<=5]b1) | !a1) & (!a1 | !b1))"]
  1 -> 2 [label="!b1 & reset(x0)\n"]
  1 -> 1 [label="!a1\n"]
  2 [label="G(((1U[x<=5]b1) | !a1) & (!a1 | !b1)) & (1U[x<=5-x0]b1) & \"x0<=5\""]
  2 -> 2 [label="!b1 & \"x0<=5\"\n"]
  2 -> 1 [label="b1 & !a1 & \"x0<=5\"\n"]
}

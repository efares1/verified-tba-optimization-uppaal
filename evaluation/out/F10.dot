digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L1;
  L1 [shape=circle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4\nx1 <= 2"];
  L6 [shape=doublecircle, label="L6\nx2 <= 5"];
  L8 [shape=doublecircle, label="L8"];
  L1 -> L2 [label="q"];
  L1 -> L4 [label="p\nx0, x1 := 0"];
  L1 -> L6 [label="p|other\nx1, x2 := 0"];
  L2 -> L2 [label="any"];
  L4 -> L2 [label="x0 > 3 && x1 <= 2: q"];
  L4 -> L4 [label="x1 <= 2: p\nx0 := 0"];
  L4 -> L8 [label="x1 <= 2: q"];
  L6 -> L2 [label="x2 <= 5: q"];
  L6 -> L4 [label="x2 <= 5: p\nx0, x1 := 0"];
  L6 -> L6 [label="x2 <= 5: p|other\nx1 := 0"];
  L8 -> L2 [label="x0 > 3: any"];
  L8 -> L8 [label="p|q"];
}

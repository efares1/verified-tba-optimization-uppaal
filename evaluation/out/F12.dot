digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=doublecircle, label="L0"];
  L2 [shape=doublecircle, label="L2\nx0 <= 5"];
  L6 [shape=doublecircle, label="L6\nx0 <= 5"];
  L0 -> L0 [label="q|other\nx0 := 0"];
  L0 -> L2 [label="p\nx0, x1 := 0"];
  L2 -> L0 [label="x0 <= 5 && x1 >= 2: q\nx0 := 0"];
  L2 -> L2 [label="x0 <= 5: p\nx1 := 0"];
  L2 -> L2 [label="x0 <= 5: other"];
  L2 -> L6 [label="x1 >= 2 && x0 <= 5: other"];
  L6 -> L0 [label="x0 <= 5: q\nx0 := 0"];
  L6 -> L2 [label="x0 <= 5: p\nx1 := 0"];
  L6 -> L6 [label="x0 <= 5: other"];
}

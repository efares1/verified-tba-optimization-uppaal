<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
  <declaration>chan e1, e2, e3, other;</declaration>
  <template>
    <name>Property</name>
    <declaration>clock x1, x0;</declaration>
    <location id="id0" x="0" y="0">
      <name>A0</name>
    </location>
    <location id="id2" x="200" y="0">
      <name>A2</name>
      <label kind="invariant">x1 &lt;= 2</label>
    </location>
    <location id="id4" x="400" y="0">
      <name>A4</name>
    </location>
    <location id="id6" x="600" y="0">
      <name>A6</name>
      <label kind="invariant">x0 &lt;= 3</label>
    </location>
    <location id="id8" x="800" y="0">
      <name>A8</name>
      <label kind="invariant">x0 &lt;= 3 &amp;&amp; x1 &lt;= 2</label>
    </location>
    <location id="id10" x="0" y="150">
      <name>A10</name>
      <label kind="invariant">x0 &lt;= 3</label>
    </location>
    <init ref="id0"/>
    <transition>
      <source ref="id10"/>
      <target ref="id10"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id10"/>
      <target ref="id10"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2 &amp;&amp; x1 - x0 &lt;= -1</label>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2 &amp;&amp; x1 - x0 &lt;= -1</label>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2 &amp;&amp; x0 - x1 &lt;= 1</label>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2 &amp;&amp; x0 - x1 &lt;= 1</label>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id6"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2</label>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id2"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x1 &lt; 2</label>
      <label kind="synchronisation">e3?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id10"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt; 3 &amp;&amp; x0 &gt;= 1</label>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id8"/>
      <label kind="guard">x0 &lt;= 1</label>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id6"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id6"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id6"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">other?</label>
      <label kind="assignment">x1 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id0"/>
      <label kind="guard">x0 &lt; 3</label>
      <label kind="synchronisation">e3?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id4"/>
      <target ref="id4"/>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id4"/>
      <target ref="id4"/>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id6"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">other?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">e3?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id2"/>
      <target ref="id2"/>
      <label kind="guard">x1 &lt; 2</label>
      <label kind="synchronisation">other?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id4"/>
      <label kind="synchronisation">e1?</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id2"/>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id2"/>
      <label kind="synchronisation">e1?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="synchronisation">e2?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="synchronisation">e3?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="synchronisation">other?</label>
      <label kind="assignment">x0 = 0, x1 = 0</label>
    </transition>
  </template>
  <template>
    <name>Env</name>
    <location id="env0" x="0" y="0"/>
    <init ref="env0"/>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">e1!</label>
    </transition>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">e2!</label>
    </transition>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">e3!</label>
    </transition>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">other!</label>
    </transition>
  </template>
  <system>P = Property();
E = Env();
system P, E;</system>
</nta>

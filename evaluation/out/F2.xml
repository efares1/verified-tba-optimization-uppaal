<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
  <declaration>chan p, q, other;</declaration>
  <template>
    <name>Property</name>
    <location id="id0" x="0" y="0">
      <name>A0</name>
    </location>
    <init ref="id0"/>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="synchronisation">q?</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="synchronisation">other?</label>
    </transition>
  </template>
  <template>
    <name>Env</name>
    <location id="env0" x="0" y="0"/>
    <init ref="env0"/>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">p!</label>
    </transition>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">q!</label>
    </transition>
    <transition>
      <source ref="env0"/>
      <target ref="env0"/>
      <label kind="synchronisation">other!</label>
    </transition>
  </template>
  <system>P = Property();
E = Env();
system P, E;</system>
</nta>

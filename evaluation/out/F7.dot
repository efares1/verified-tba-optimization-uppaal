digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=doublecircle, label="L0"];
  L2 [shape=doublecircle, label="L2\nx0 <= 5"];
  L0 -> L0 [label="p\nx0 := 0"];
  L0 -> L2 [label="other\nx0 := 0"];
  L2 -> L0 [label="x0 <= 5: p\nx0 := 0"];
  L2 -> L2 [label="x0 <= 5: other"];
}

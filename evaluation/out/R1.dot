digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=doublecircle, label="L0"];
  L2 [shape=doublecircle, label="L2\nx0 <= 5"];
  L0 -> L0 [label="b1|other\nx0 := 0"];
  L0 -> L2 [label="a1\nx0 := 0"];
  L2 -> L0 [label="x0 <= 5: b1\nx0 := 0"];
  L2 -> L2 [label="x0 <= 5: a1|other"];
}

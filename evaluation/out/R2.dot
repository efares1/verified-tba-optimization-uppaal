digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=doublecircle, label="L0"];
  L2 [shape=doublecircle, label="L2\nx1 <= 5"];
  L4 [shape=doublecircle, label="L4\nx0 <= 5 && x1 <= 5"];
  L6 [shape=doublecircle, label="L6\nx0 <= 5"];
  L0 -> L0 [label="b1|b2|other\nx0, x1 := 0"];
  L0 -> L2 [label="a2\nx0, x1 := 0"];
  L0 -> L6 [label="a1\nx0, x1 := 0"];
  L2 -> L0 [label="x1 <= 5: b2\nx0, x1 := 0"];
  L2 -> L2 [label="x1 <= 5: a2|b1|other\nx0 := 0"];
  L2 -> L4 [label="x1 <= 5 && x1 >= -0: a1\nx1 <= 0: a1\nx0 := 0"];
  L4 -> L2 [label="x0 <= 5 && x1 <= 5: b1\nx0 := 0"];
  L4 -> L4 [label="x0 <= 5 && x1 <= 5 && x0 - x1 <= 0: a1|a2|other\nx0 <= 5 && x1 <= 5 && x1 - x0 <= 0: a1|a2|other"];
  L4 -> L6 [label="x1 <= 5 && x0 <= 5: b2\nx1 := 0"];
  L6 -> L0 [label="x0 <= 5: b1\nx0, x1 := 0"];
  L6 -> L4 [label="x0 <= 0: a2\nx0 <= 5 && x0 >= -0: a2\nx1 := 0"];
  L6 -> L6 [label="x0 <= 5: a1|b2|other\nx1 := 0"];
}

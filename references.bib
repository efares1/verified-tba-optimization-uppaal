@InProceedings{mightyl_paper17,
author="Brihaye, Thomas
and Geeraerts, Gilles
and Ho, Hsi-Ming
and Monmege, Benjamin",
editor="Majumdar, Rupak
and Kun{\v{c}}ak, Viktor",
title="{MightyL}: A Compositional Translation from {MITL} to Timed Automata",
booktitle="Computer Aided Verification",
year="2017",
publisher="Springer International Publishing",
address="Cham",
pages="421--440",
abstract="Metric Interval Temporal Logic (MITL ) was first proposed in the early 1990s as a specification formalism for real-time systems. Apart from its appealing intuitive syntax, there are also theoretical evidences that make MITL a prime real-time counterpart of Linear Temporal Logic (LTL ). Unfortunately, the tool support for MITL verification is still lacking to this day. In this paper, we propose a new construction from MITL to timed automata via very-weak one-clock alternating timed automata. Our construction subsumes the well-known construction from LTL to B{\"u}chi automata by Gastin and Oddoux and yet has the additional benefits of being compositional and integrating easily with existing tools. We implement the construction in our new tool MightyL and report on experiments using Uppaal and LTSmin as back-ends.",
isbn="978-3-319-63387-9"
}



\lstdefinelanguage{Xtext}{
 inputencoding=utf8,
 literate=,
 morekeywords={grammar, with, hidden, generate, as, import, returns, current, terminal, enum},
 keywordstyle=[2]{\textbf},
 stringstyle=\color{xtextBlue},
 morekeywords=[3]{name},
 keywordstyle=[3]\color{xtextOrange},
 morecomment=[l]{//}, 
 morecomment=[s]{/*}{*/}, 
 morestring=[b]",
 morestring=[b]',
 moredelim=**[is][\color{gray}]{`}{`},
 moredelim=*[s][\color{red}]{[}{]},
 tabsize=4}
  
\definecolor{xtextOrange}{RGB}{171,48,0}
\definecolor{xtextBlue}{RGB}{0,0,255}
